# Dependencies: huge, and rebuilt with `npm install`
node_modules/

# Environment files: hold secrets like the database URL and password
.env
.env.*

# Exception: the example file has no real secrets, so keep it tracked
!.env.example

# Build output: generated by tsc (backend) or Vite (frontend)
dist/

# Log files created by npm or other tools
*.log

# Editor settings
.vscode/

# Windows system files created by File Explorer
Thumbs.db
desktop.ini

# Mac system file (harmless to keep if a Mac user ever clones the repo)
.DS_Store